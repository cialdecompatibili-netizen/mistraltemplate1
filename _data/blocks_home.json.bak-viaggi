[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap\" rel=\"stylesheet\">\n<style>\n.rf{--ink:#17252e;--cream:#f7f1e8;--gold:#9a4423;--gold2:#e0956b;--mut:#4f5b64;--line:#e6dccd;--serif:'Playfair Display',Georgia,serif;--sans:'Inter',system-ui,sans-serif;font-family:var(--sans);color:var(--ink)}\n.rf *{box-sizing:border-box}\n.rf-wrap{max-width:1180px;margin:0 auto;padding:0 1.5rem}\n.rf-eyebrow{font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:600;margin:0 0 1rem}\n.rf-h2{font-family:var(--serif);font-weight:500;font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.15;margin:0 0 .75rem;color:var(--ink)}\n.rf-lead{font-size:1.08rem;line-height:1.7;color:var(--mut);max-width:58ch;margin:0}\n.rf-sec{padding:clamp(3rem,7vw,5.5rem) 0}.rf-sec-c{background:var(--cream)}\n.rf-btn{display:inline-flex;align-items:center;min-height:48px;padding:.8rem 1.6rem;font:600 .84rem var(--sans);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border:1px solid var(--ink);border-radius:4px;transition:background .2s,color .2s}\n.rf-btn-k{background:var(--ink);color:#fff}.rf-btn-k:hover{background:#fff;color:var(--ink)}\n.rf-btn-o{color:var(--ink);background:transparent}.rf-btn-o:hover{background:var(--ink);color:#fff}\n.rf-btn:focus-visible,.rf a:focus-visible{outline:3px solid var(--gold2);outline-offset:3px}\n.rf-hero{background:var(--cream);padding:clamp(2rem,5vw,4rem) 0}\n.rf-hero-in{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.rf-hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(2.3rem,5vw,4.3rem);line-height:1.06;margin:0 0 1.25rem;letter-spacing:-.01em;text-wrap:balance}\n.rf-hero h1 em{color:var(--gold);font-style:italic}\n.rf-hero p{font-size:1.15rem;line-height:1.7;color:var(--mut);max-width:46ch;margin:0 0 1.2rem}\n.rf-hero p.rf-pts{font-size:.95rem;margin:0 0 2rem;color:var(--ink)}\n.rf-act{display:flex;gap:.9rem;flex-wrap:wrap}\n.rf-hero-fig{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:.8rem}\n.rf-hero-fig img{width:100%;height:100%;object-fit:cover;display:block;border-radius:4px}\n.rf-hero-fig .a{grid-row:span 2;aspect-ratio:3/4.4}.rf-hero-fig .b,.rf-hero-fig .c{aspect-ratio:1/1}\n.rf-cats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.2rem}\n.rf-cat{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#222;color:#fff;text-decoration:none;border-radius:4px}\n.rf-cat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.85;transition:transform .5s,opacity .3s}\n.rf-cat:hover img{transform:scale(1.04);opacity:1}\n.rf-cat-t{position:absolute;left:0;right:0;bottom:0;padding:3rem 1.1rem 1.1rem;background:linear-gradient(transparent,rgba(0,0,0,.82))}\n.rf-cat-t b{display:block;font-family:var(--serif);font-weight:500;font-size:1.3rem;color:#fff;line-height:1.2}\n.rf-cat-t span{font-size:.86rem;color:#f3ece2}\n.rf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2.2rem 1.6rem;margin-top:2.2rem}\n.rf-card{display:flex;flex-direction:column;text-decoration:none;color:var(--ink)}\n.rf-card-im{display:block;aspect-ratio:4/3;overflow:hidden;background:var(--cream);margin-bottom:1rem;border-radius:4px}\n.rf-card-im img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}\n.rf-card:hover .rf-card-im img{transform:scale(1.04)}\n.rf-card-cat{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:.45rem}\n.rf-card-t{font-family:var(--serif);font-size:1.35rem;line-height:1.25;margin-bottom:.5rem;font-weight:500}\n.rf-card:hover .rf-card-t{text-decoration:underline;text-underline-offset:4px}\n.rf-card-d{font-size:.95rem;line-height:1.6;color:var(--mut)}\n.rf-card-p{margin-top:.6rem;font-weight:600;font-size:.95rem}\n.rf-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap}\n.rf-link{font:600 .82rem var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border-bottom:1px solid var(--ink);padding-bottom:3px;text-decoration:none}\n.rf-2c{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.rf-2c img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;border-radius:4px}\n.rf-dark{background:var(--ink);color:#fff;text-align:center}.rf-dark .rf-h2{color:#fff}.rf-dark .rf-lead{color:#d6dde2;margin:0 auto 2rem}.rf-dark .rf-eyebrow{color:var(--gold2)}\n.rf-dark .rf-btn{background:#fff;color:var(--ink);border-color:#fff}.rf-dark .rf-btn:hover{background:transparent;color:#fff}\n.rf-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:2.2rem}\n.rf-step{background:#fff;border:1px solid var(--line);border-radius:6px;padding:1.6rem}\n.rf-step b{display:block;font-family:var(--serif);font-weight:500;font-size:1.25rem;margin:.3rem 0 .5rem}\n.rf-step span.n{font:600 .8rem var(--sans);letter-spacing:.18em;color:var(--gold)}\n.rf-step p{margin:0;color:var(--mut);line-height:1.6;font-size:.98rem}\n.rf-seas{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.6rem}\n.rf-sea{display:block;text-decoration:none;color:var(--ink);background:var(--cream);border-radius:6px;padding:1.3rem;border:1px solid var(--line);transition:border-color .2s}\n.rf-sea:hover{border-color:var(--ink)}\n.rf-sea b{display:block;font-family:var(--serif);font-weight:500;font-size:1.3rem;margin-bottom:.4rem}\n.rf-sea span{font-size:.93rem;line-height:1.55;color:var(--mut)}\n.rf-list{margin:1.2rem 0 0;padding:0;list-style:none}.rf-list li{padding:.45rem 0;border-bottom:1px solid var(--line);color:var(--ink)}\n.rf-net{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:2.2rem}\n.rf-nt{display:flex;flex-direction:column;text-decoration:none;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:6px;overflow:hidden;transition:border-color .2s}\n.rf-nt:hover{border-color:var(--ink)}\n.rf-nt img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}\n.rf-nt div{padding:1.2rem 1.3rem 1.4rem}.rf-nt b{display:block;font-family:var(--serif);font-weight:500;font-size:1.25rem;margin-bottom:.4rem}\n.rf-nt span{font-size:.95rem;line-height:1.55;color:var(--mut)}\n@media(max-width:900px){.rf-hero-in,.rf-2c{grid-template-columns:1fr}.rf-cats{grid-template-columns:repeat(2,1fr)}.rf-grid,.rf-steps,.rf-net{grid-template-columns:repeat(2,1fr)}.rf-seas{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:560px){.rf-grid,.rf-steps,.rf-net,.rf-seas{grid-template-columns:1fr}.rf-hero-fig .a{aspect-ratio:3/4}}\n@media(prefers-reduced-motion:reduce){.rf *{transition:none!important}}\n</style><div class=\"rf\"><section class=\"rf-hero\"><div class=\"rf-wrap rf-hero-in\"><div><p class=\"rf-eyebrow\">Mentana · Roma · Lazio</p><h1>Gite, tour e weekend <em>da Mentana</em>, senza pensieri</h1><p>Pullman, guida e hotel già organizzati. Scegli il tour, ti pre-iscrivi senza pagare e partiamo quando il gruppo è pronto.</p><p class=\"rf-pts\">Gite in giornata · Weekend · Neve · Vino e sapori · Roma di notte · Gruppi e scuole</p><div class=\"rf-act\"><a class=\"rf-btn rf-btn-k\" href=\"__BASEURL__/tour/\">Scegli un tour</a><a class=\"rf-btn rf-btn-o\" href=\"#\" target=\"_blank\" rel=\"noopener\">Scrivici su WhatsApp</a></div></div><figure class=\"rf-hero-fig\"><img class=\"a\" src=\"__BASEURL__/assets/tour/hero-roma.jpg\" alt=\"Il Colosseo a Roma\" fetchpriority=\"high\"><img class=\"b\" src=\"__BASEURL__/assets/tour/weekend-guidati.jpg\" alt=\"Civita di Bagnoregio\"><img class=\"c\" src=\"__BASEURL__/assets/tour/neve-inverno.jpg\" alt=\"Neve in montagna nel Lazio\"></figure></div></section></div>"
  },
  {
    "id": "shop",
    "nome": "Categorie",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec\" id=\"categorie\"><div class=\"rf-wrap\"><div class=\"rf-head\"><div><p class=\"rf-eyebrow\">Cosa organizziamo</p><h2 class=\"rf-h2\">Scegli il tuo tipo di viaggio</h2></div><a class=\"rf-link\" href=\"__BASEURL__/tour/\">Tutte le categorie</a></div><div class=\"rf-cats\"><a class=\"rf-cat\" href=\"__BASEURL__/tour/gite-guidate/\"><img src=\"__BASEURL__/assets/tour/gite-guidate.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Gite guidate in giornata</b><span>Un giorno in pullman con guida</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/weekend-guidati/\"><img src=\"__BASEURL__/assets/tour/weekend-guidati.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Weekend e viaggi guidati</b><span>Due o tre giorni con hotel</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/neve-inverno/\"><img src=\"__BASEURL__/assets/tour/neve-inverno.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Neve e inverno</b><span>Sulla neve con accompagnatore</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/vino-sapori/\"><img src=\"__BASEURL__/assets/tour/vino-sapori.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Vino e sapori del Lazio</b><span>Cantine e pranzi tipici</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/natale-capodanno/\"><img src=\"__BASEURL__/assets/tour/natale-capodanno.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Natale, mercatini e feste</b><span>Mercatini e luminarie</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/terme-benessere/\"><img src=\"__BASEURL__/assets/tour/terme-benessere.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Terme e benessere</b><span>Relax alle terme</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/mare-barca/\"><img src=\"__BASEURL__/assets/tour/mare-barca.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Mare, barca e isole</b><span>Ponza, Circeo, Sabaudia</span></span></a><a class=\"rf-cat\" href=\"__BASEURL__/tour/roma-di-notte/\"><img src=\"__BASEURL__/assets/tour/roma-di-notte.jpg\" alt=\"\" loading=\"lazy\"><span class=\"rf-cat-t\"><b>Roma di notte</b><span>Serate guidate a Roma</span></span></a></div></div></section></div>"
  },
  {
    "id": "ultimi",
    "nome": "Tour in partenza",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec rf-sec-c\" id=\"popolari\"><div class=\"rf-wrap\"><div class=\"rf-head\"><div><p class=\"rf-eyebrow\">Le prossime partenze</p><h2 class=\"rf-h2\">Tour che stiamo preparando</h2></div><a class=\"rf-link\" href=\"__BASEURL__/tour/gite-guidate/\">Vedi le gite</a></div><div class=\"rf-grid\"><a class=\"rf-card\" href=\"__BASEURL__/tour/gita-pompei-vesuvio/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/gite-guidate.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Gite guidate in giornata</span><span class=\"rf-card-t\">Pompei e Vesuvio: gita guidata in pullman</span><span class=\"rf-card-d\">Scavi di Pompei con guida, in giornata, con salita al Vesuvio facoltativa.</span><span class=\"rf-card-p\">da 79 € a persona</span></a><a class=\"rf-card\" href=\"__BASEURL__/tour/gita-civita-orvieto-guidata/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/gite-guidate.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Gite guidate in giornata</span><span class=\"rf-card-t\">Civita di Bagnoregio e Orvieto con guida</span><span class=\"rf-card-d\">Il borgo sospeso e la città del Duomo in un giorno.</span><span class=\"rf-card-p\">da 59 € a persona</span></a><a class=\"rf-card\" href=\"__BASEURL__/tour/neve-monte-livata-accompagnatore/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/neve-inverno.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Neve e inverno</span><span class=\"rf-card-t\">Giornata sulla neve a Monte Livata</span><span class=\"rf-card-d\">In pullman con accompagnatore: la montagna più vicina a Roma.</span><span class=\"rf-card-p\">da 35 € a persona</span></a><a class=\"rf-card\" href=\"__BASEURL__/tour/weekend-tuscia-viterbo/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/weekend-guidati.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Weekend e viaggi guidati</span><span class=\"rf-card-t\">Weekend guidato in Tuscia: Viterbo, Civita e Bomarzo</span><span class=\"rf-card-d\">Due giorni con guida, pullman e hotel nella Tuscia.</span><span class=\"rf-card-p\">da 189 € a persona</span></a><a class=\"rf-card\" href=\"__BASEURL__/tour/vino-frascati-cantina-guidata/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/vino-sapori.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Vino e sapori del Lazio</span><span class=\"rf-card-t\">Frascati: cantina e degustazione guidata</span><span class=\"rf-card-d\">Mezza giornata tra vigne e cantina, con tre vini e assaggi.</span><span class=\"rf-card-p\">da 59 € a persona</span></a><a class=\"rf-card\" href=\"__BASEURL__/tour/natale-bolzano-trento/\"><span class=\"rf-card-im\"><img src=\"__BASEURL__/assets/tour/natale-capodanno.jpg\" alt=\"\" loading=\"lazy\"></span><span class=\"rf-card-cat\">Natale, mercatini e feste</span><span class=\"rf-card-t\">Mercatini di Natale a Bolzano e Trento</span><span class=\"rf-card-d\">Due giorni nei mercatini più famosi, con pullman e hotel.</span><span class=\"rf-card-p\">da 159 € a persona</span></a></div></div></section></div>"
  },
  {
    "id": "sezioni",
    "nome": "Come funziona",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec\" id=\"come-funziona\"><div class=\"rf-wrap\"><p class=\"rf-eyebrow\">Come funziona</p><h2 class=\"rf-h2\">Ti pre-iscrivi, noi organizziamo</h2><p class=\"rf-lead\">Nessun pagamento anticipato: il gruppo parte quando raggiunge il minimo di iscritti. Se non si parte, non paghi nulla.</p><div class=\"rf-steps\"><div class=\"rf-step\"><span class=\"n\">1</span><b>Scegli e scrivici</b><p>Trovi il tour, ti pre-iscrivi con un messaggio su WhatsApp o dal modulo.</p></div><div class=\"rf-step\"><span class=\"n\">2</span><b>Raggiungiamo il gruppo</b><p>Di solito servono circa 20 persone. Ti avvisiamo appena si conferma.</p></div><div class=\"rf-step\"><span class=\"n\">3</span><b>Si parte</b><p>Almeno 7 giorni prima ti comunichiamo data e punti di salita comodi per gli iscritti.</p></div></div><div class=\"rf-seas\"><a class=\"rf-sea\" href=\"__BASEURL__/tour/neve-inverno/\"><b>Inverno</b><span>Neve, mercatini di Natale, luminarie e Roma più tranquilla.</span></a><a class=\"rf-sea\" href=\"__BASEURL__/tour/gite-guidate/\"><b>Primavera</b><span>Borghi, laghi e città d'arte con meno folla e prezzi più bassi.</span></a><a class=\"rf-sea\" href=\"__BASEURL__/tour/mare-barca/\"><b>Estate</b><span>Mare, isole e barca; Roma al mattino presto o la sera.</span></a><a class=\"rf-sea\" href=\"__BASEURL__/tour/vino-sapori/\"><b>Autunno</b><span>Cantine, vendemmia, castagne e terme.</span></a></div></div></section></div>"
  },
  {
    "id": "classifiche",
    "nome": "Gruppi e aziende",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec rf-sec-c\" id=\"gruppi\"><div class=\"rf-wrap rf-2c\"><img src=\"__BASEURL__/assets/tour/gruppi-scuole-aziende.jpg\" alt=\"Assisi\" loading=\"lazy\"><div><p class=\"rf-eyebrow\">Su misura</p><h2 class=\"rf-h2\">Per gruppi, scuole e aziende</h2><p class=\"rf-lead\">Hai un gruppo? Scegli la meta e ti mandiamo un preventivo gratuito, con pullman, guida e pranzo.</p><ul class=\"rf-list\"><li>Gite scolastiche e team building aziendale</li><li>Circoli, parrocchie e associazioni</li><li>Pellegrinaggi e gite per la terza età</li><li>Transfer, noleggio pullman, concerti e feste</li></ul><p style=\"margin-top:1.8rem\"><a class=\"rf-btn rf-btn-k\" href=\"__BASEURL__/gruppi-e-aziende/\">Chiedi un preventivo</a></p></div></div></section></div>"
  },
  {
    "id": "maison",
    "nome": "Network Nomentum",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec\" id=\"network\"><div class=\"rf-wrap\"><p class=\"rf-eyebrow\">Dal network Nomentum</p><h2 class=\"rf-h2\">Dormi, scopri, trasferisciti</h2><p class=\"rf-lead\">Mentana è vicina a Roma, alla montagna e al mare: chi viene da fuori può fermarsi qui e partire con noi.</p><div class=\"rf-net\"><a class=\"rf-nt\" href=\"https://cialdecompatibili-netizen.github.io/villanomentum/\" target=\"_blank\" rel=\"noopener\"><img src=\"__BASEURL__/assets/tour/villa-nomentum.jpg\" alt=\"\" loading=\"lazy\"><div><b>Villa Nomentum</b><span>Dormi a Mentana, a 25 km da Roma, e parti con i nostri tour.</span></div></a><a class=\"rf-nt\" href=\"https://cialdecompatibili-netizen.github.io/nomentumimmobiliare/\" target=\"_blank\" rel=\"noopener\"><img src=\"__BASEURL__/assets/tour/borgo-colline.jpg\" alt=\"\" loading=\"lazy\"><div><b>Immobiliare Nomentum</b><span>Ti piace la zona? Case e ville in vendita e in affitto a Mentana e dintorni.</span></div></a><a class=\"rf-nt\" href=\"https://cialdecompatibili-netizen.github.io/nomentumtravel/\" target=\"_blank\" rel=\"noopener\"><img src=\"__BASEURL__/assets/tour/roma-tour-guidati.jpg\" alt=\"\" loading=\"lazy\"><div><b>Nomentum Travel</b><span>Il sito in inglese per chi arriva dall'estero: stay near Rome.</span></div></a></div></div></section></div>"
  },
  {
    "id": "contatti",
    "nome": "Contatti",
    "enabled": true,
    "html": "<div class=\"rf\"><section class=\"rf-sec rf-dark\" id=\"contatti\"><div class=\"rf-wrap\"><p class=\"rf-eyebrow\">Contatti</p><h2 class=\"rf-h2\">Dove vuoi andare?</h2><p class=\"rf-lead\">Scrivici la meta, il periodo e quante persone siete: ti rispondiamo con una proposta.</p><a class=\"rf-btn\" href=\"#\" target=\"_blank\" rel=\"noopener\">WhatsApp</a> <a class=\"rf-btn\" href=\"__BASEURL__/contatti/\">Modulo contatti</a></div></section></div>"
  }
]